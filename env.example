# === Config du bot Discord ===

# Token de ton bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Client ID de l'application (Discord Developer Portal > General Information > Application ID)
CLIENT_ID=

# (Optionnel) ID du serveur pour un déploiement instantané des commandes en dev.
# Laisse vide pour un déploiement global (peut prendre jusqu'à 1h à apparaître).
GUILD_ID=

# ID du salon où le message de présence doit être posté
CHANNEL_ID=

# ID du rôle à mentionner (ex: @CELTIC MOB). Laisse vide pour ne mentionner personne.
ROLE_ID=

# Heure(s) d'envoi automatique, au format cron (heure serveur / TIMEZONE ci-dessous)
# Exemples :
#   "0 18 * * *"      -> tous les jours à 18h00
#   "0 18 * * 5,6"    -> les vendredis et samedis à 18h00
#   "0 18,20 * * *"   -> tous les jours à 18h00 ET 20h00
SCHEDULE_CRON=0 18 * * *

# Fuseau horaire utilisé pour le cron
TIMEZONE=Europe/Paris

# Lieu de RDV par défaut
DEFAULT_LOCATION=villa

# Code postal par défaut (laisse vide si non utilisé)
DEFAULT_CP=7035
